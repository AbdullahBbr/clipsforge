# ClipForge settings. Copy to .env and change what you need.
# Where jobs, clips and the database live.
CLIPFORGE_DATA=
# Port the web app listens on.
CLIPFORGE_PORT=8765
# Whisper model used for local transcription: tiny is fastest, base is more accurate.
CLIPFORGE_WHISPER_MODEL=base
# Optional: a browser cookies.txt for YouTube (helps when YouTube refuses downloads).
# CLIPFORGE_YT_COOKIES=
# Optional: YouTube upload (scheduler) needs OAuth client secrets, see README.
# CLIPFORGE_YOUTUBE_CLIENT_SECRETS=
